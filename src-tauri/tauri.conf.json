{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fader",
  "version": "0.1.0",
  "identifier": "io.github.pierresylla.fader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' 'unsafe-inline'; connect-src 'self' ws://localhost:1420 ws://127.0.0.1:1420 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
